  "cross_surface_notes": [
    {
      "note_id": "report.partially_eligible_unauth_only",
      "surface": "Dispute Detail Custom report (SFTP, approved merchants)",
      "source": "https://developer.paypal.com/docs/reports/sftp-reports/dispute-detail-custom/#case-fields",
      "says": "Its 'Seller Protection' column defines 'Partially Eligible Unauth Only' as protection for Unauthorized Payment only, 'Eligible' as Unauthorized Payment and Item Not Received, and 'Ineligible' as not protected.",
      "bearing": "Compare with the Orders v2 description of PARTIALLY_ELIGIBLE (item-not-received only). Different surfaces, different scope: the token/label equivalence is not established and Delivery Gate does not assume it."
    }
  ]
}
