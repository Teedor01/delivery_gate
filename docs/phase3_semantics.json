      "semantics_id": "orders_v2.capture.seller_protection.status=ELIGIBLE",
      "api": "PayPal Orders v2",
      "field": "capture.seller_protection.status",
      "value": "ELIGIBLE",
      "meaning_status": "DOCUMENTED",
      "documented_meaning": "PayPal states the seller's PayPal balance remains intact if the customer claims they did not receive an item OR the account holder claims they did not authorize the payment.",
      "described_claim_types": [
        "customer did not receive an item",
        "account holder did not authorize the payment"
      ],
      "sources": [
        "https://developer.paypal.com/api/orders/v2/definitions/capture#seller_protection.status"
      ],
      "legal_policy_equivalence": "NOT_ESTABLISHED",
      "equivalence_note": "The API describes the effect on the seller's PayPal balance for the claim types named. That is not shown to be the same as the 'eligible'/'partially eligible' mark on the Transaction Details page that the legal policy refers to, no PayPal document links the two, and the policy says PayPal decides at dispute time. A differently-scoped description of a similarly named value exists on another PayPal surface (see CROSS_SURFACE_NOTES), so equivalence across surfaces cannot be assumed.",
      "retrieved": "2026-11-01"
    },
