# Delivery Gate: configuration reference. Copy to .env and fill in ONLY if you want live extraction.
#
# The application reads the PROCESS ENVIRONMENT. It does not load .env files by itself.
# To use a .env file in a POSIX shell:   set -a; . ./.env; set +a
#
# Nothing here is required. With neither variable set, the app runs entirely offline on fixtures,
# and the 15 built-in sample documents are read from recorded extraction outputs.

# --- Optional: live evidence extraction (BOTH must be set to enable it) -----------------------------
# Your own Anthropic API key. Never commit a real key. The key is read server-side only and is never
# sent to the browser (tests/test_ui_http.py and tests/test_ui_mutations.py check this).
ANTHROPIC_API_KEY=your-anthropic-api-key-here
# The model identifier to use for extraction. No default is guessed by the code: choose one you have
# access to (see the Anthropic documentation for current model names).
EXTRACTION_MODEL=your-model-identifier-here

# --- Server address (command-line flags, not environment variables) ---------------------------------
#   python3 -m delivery_ui --host 127.0.0.1 --port 8080
# Defaults: host 127.0.0.1, port 8080. The demo is not hardened for exposure beyond localhost.

# --- Optional: read-only PayPal SANDBOX check (separate command-line tool; see docs/PAYPAL_SANDBOX.md) --------
# Sandbox REST app credentials from https://developer.paypal.com (Apps & Credentials, Sandbox tab).
# These are SANDBOX credentials only. The client can only contact api-m.sandbox.paypal.com and cannot move money.
PAYPAL_SANDBOX_CLIENT_ID=your-sandbox-client-id-here
PAYPAL_SANDBOX_CLIENT_SECRET=your-sandbox-client-secret-here
